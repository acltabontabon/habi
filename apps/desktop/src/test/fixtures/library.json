      "kind": "workflow",
      "title": "Liquibase migration review",
      "name": "liquibase-migration-review",
      "description": "Review Liquibase changelogs for safe, reversible database migrations. Use when a change adds or edits files under db/changelog, or when asked to review a schema migration.",
      "path": "skills/liquibase-migration-review",
      "owner": "Platform Guild (example)",
      "license": "Apache-2.0",
      "licenseFile": null,
      "licenseRestricted": false,
      "compatibility": null,
      "requirement": "recommended",
      "priority": 20,
      "scope": "module",
      "appliesWhen": {
        "op": "all",
        "items": [
          {
            "op": "tag",
            "tag": "framework:spring-boot"
          },
          {
            "op": "any",
            "items": [
              {
                "op": "dependency",
                "name": "org.liquibase:liquibase-core",
                "ecosystem": "jvm",
                "version": null
              },
              {
                "op": "tag",
                "tag": "db:liquibase"
              }
            ]
          }
        ]
      },
      "excludes": null,
      "tools": [
        {
          "name": "Maven or Gradle wrapper",
          "commands": [
            "./mvnw",
            "mvn",
            "./gradlew",
            "gradle"
          ],
          "purpose": "Runs Liquibase validation through the build.",
          "installHint": null
        }
      ],
      "mcp": [],
      "clients": [
        "claude-code",
        "cursor",
        "codex"
      ],
      "workflow": {
        "steps": [
          {
            "title": "Locate the master changelog",
            "detail": "Find db.changelog-master.* and confirm new changesets are included from it.",
            "references": [],
            "expected": null
          },
          {
            "title": "Review each new changeset",
            "detail": "Apply the checklist to every changeset added or modified by the change.",
            "references": [
              "references/checklist.md"
            ],
            "expected": null
          },
          {
            "title": "Assess locking and rollback risk",
            "detail": "Flag NOT NULL additions without defaults, large index builds, renames and missing rollbacks.",
            "references": [],
            "expected": null
          },
          {
            "title": "Validate the changelog",
            "detail": "Run the validation check below when a database-independent validation is available.",
            "references": [],
            "expected": "The validate goal exits successfully."
          }
        ],
        "artifacts": [
          "Review comment listing blocking issues, risks and suggestions with changeset ids"
        ]
      },
      "bindings": [
        {
          "name": "changelog",
          "kind": "file",
          "glob": "**/db/changelog/db.changelog-master.*",
          "description": "The master changelog to validate."
        }
      ],
      "checks": [
        {
          "id": "changelog-is-wellformed",
          "title": "Changelog parses as XML/YAML",
          "description": "Confirms the master changelog is readable by Liquibase's parser via the Maven plugin (no database connection).",
          "run": [
            {
              "type": "literal",
              "value": "./mvnw"
            },
            {
              "type": "literal",
              "value": "-q"
            },
            {
              "type": "literal",
              "value": "-DskipTests"
            },
            {
              "type": "literal",
              "value": "liquibase:validate"
            }
          ],
          "cwd": "module",
          "timeoutSeconds": 600
        }
      ],
      "evidence": [
