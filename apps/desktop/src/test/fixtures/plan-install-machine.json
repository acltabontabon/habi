              {
                "tag": "added",
                "oldLine": null,
                "newLine": 7,
                "text": "applies_when:"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 8,
                "text": "  all:"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 9,
                "text": "    - tag: framework:spring-boot"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 10,
                "text": "    - any:"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 11,
                "text": "        - dependency: { name: \"org.liquibase:liquibase-core\", ecosystem: jvm }"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 12,
                "text": "        - tag: db:liquibase"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 13,
                "text": "requires:"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 14,
                "text": "  tools:"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 15,
                "text": "    - name: Maven or Gradle wrapper"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 16,
                "text": "      commands: [./mvnw, mvn, ./gradlew, gradle]"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 17,
                "text": "      purpose: Runs Liquibase validation through the build."
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 18,
                "text": "  clients: [claude-code, cursor, codex]"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 19,
                "text": "workflow:"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 20,
                "text": "  steps:"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 21,
                "text": "    - title: Locate the master changelog"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 22,
                "text": "      detail: Find db.changelog-master.* and confirm new changesets are included from it."
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 23,
                "text": "    - title: Review each new changeset"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 24,
                "text": "      detail: Apply the checklist to every changeset added or modified by the change."
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 25,
                "text": "      references: [references/checklist.md]"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 26,
                "text": "    - title: Assess locking and rollback risk"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 27,
                "text": "      detail: Flag NOT NULL additions without defaults, large index builds, renames and missing rollbacks."
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 28,
                "text": "    - title: Validate the changelog"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 29,
                "text": "      detail: Run the validation check below when a database-independent validation is available."
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 30,
                "text": "      expected: The validate goal exits successfully."
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 31,
                "text": "  artifacts:"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 32,
                "text": "    - Review comment listing blocking issues, risks and suggestions with changeset ids"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 33,
                "text": "bindings:"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 34,
                "text": "  - name: changelog"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 35,
                "text": "    kind: file"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 36,
                "text": "    glob: \"**/db/changelog/db.changelog-master.*\""
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 37,
                "text": "    description: The master changelog to validate."
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 38,
                "text": "checks:"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 39,
                "text": "  - id: changelog-is-wellformed"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 40,
                "text": "    title: Changelog parses as XML/YAML"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 41,
                "text": "    description: Confirms the master changelog is readable by Liquibase's parser via the Maven plugin (no database connection)."
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 42,
                "text": "    run: [\"./mvnw\", \"-q\", \"-DskipTests\", \"liquibase:validate\"]"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 43,
                "text": "    cwd: module"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 44,
                "text": "    timeout_seconds: 600"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 45,
                "text": "evidence:"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 46,
                "text": "  - date: 2026-08-14"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 47,
                "text": "    result: passed"
              },
              {
