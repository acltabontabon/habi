            "header": "@@ -1,0 +1,9 @@",
            "lines": [
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 1,
                "text": "# Changelog checklist"
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 2,
                "text": ""
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 3,
                "text": "- [ ] Changeset `id` and `author` are set and unique."
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 4,
                "text": "- [ ] The changeset is included from the master changelog."
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 5,
                "text": "- [ ] A rollback exists, or the comment explains why it is irreversible."
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 6,
                "text": "- [ ] New `NOT NULL` columns have a default or a backfill step."
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 7,
                "text": "- [ ] Large-table index creation will not lock writes."
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 8,
                "text": "- [ ] No previously released changeset was modified (checksum change)."
              },
              {
                "tag": "added",
                "oldLine": null,
                "newLine": 9,
                "text": "- [ ] Data migrations are idempotent."
              }
            ]
          }
        ],
        "added": 9,
        "removed": 0,
        "binary": false,
        "truncated": false
      },
