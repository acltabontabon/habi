              },
              {
                "tag": "removed",
                "oldLine": 3,
                "newLine": null,
                "text": "description: Review Liquibase changelogs for safe, reversible database migrations. Use when a change adds or edits files under db/changelog, or when asked to review a schema migration."
              },
              {
                "tag": "removed",
