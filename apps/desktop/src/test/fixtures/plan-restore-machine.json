                "tag": "removed",
                "oldLine": 25,
                "newLine": null,
                "text": ""
              },
              {
                "tag": "removed",
                "oldLine": 26,
                "newLine": null,
                "text": "A short review with file and changeset ids for every finding."
              }
            ]
