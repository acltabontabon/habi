{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Habi",
  "version": "0.1.0",
  "identifier": "com.acltabontabon.habi",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Habi",
        "width": 1320,
        "height": 860,
        "minWidth": 1320,
        "minHeight": 860,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "Alvin Cris Tabontabon",
    "copyright": "Copyright 2026 Alvin Cris Tabontabon and Habi contributors",
    "homepage": "https://github.com/acltabontabon/habi",
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "shortDescription": "Find what applies. Improve what works. Share what you learn.",
    "longDescription": "Find what applies. Improve what works. Share what you learn. Habi shows which skills and instructions fit the repository you are working in, from My skills, team libraries and community libraries, and explains why. It installs them for Claude Code, Cursor and Codex with a preview of every file, and shares what you improve back to the library it came from as a reviewed change.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null,
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "certificateThumbprint": null
    },
    "resources": {
      "../../../fixtures/libraries/": "samples/libraries/",
      "../../../fixtures/repos/": "samples/repos/",
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE": "NOTICE",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyREQ5RTIyMUREMUZDRjcKUldUMy9ORWRJcDdkNG9EM05JdWxqQkptWHhmVG55NFR4SHhyZ2hHbks3aExwUk1Qc010eTZLd0YK",
      "endpoints": [
        "https://github.com/acltabontabon/habi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
