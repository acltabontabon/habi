---
import Bridge from "../components/Bridge.astro";
import Duo from "../components/Duo.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import Start from "../components/Start.astro";
import Weave from "../components/Weave.astro";
import Base from "../layouts/Base.astro";
---

<Base
  title="Habi — what one developer learns, every project keeps"
  description="Find what applies. Improve what works. Share what you learn. Habi is an open-source desktop app for macOS and Windows that shows which AI agent skills for Claude Code, Cursor, Codex, Gemini CLI, GitHub Copilot, OpenCode and Junie fit the repository you are in, and sends what you improve back to the team that owns it."
>
  <Header />
  <main id="main">
    <Hero />
    <Problem />
    <Bridge />
    <Weave />
    <Duo />
    <Start />
  </main>
  <script>
    import "../scripts/site";
  </script>
</Base>
