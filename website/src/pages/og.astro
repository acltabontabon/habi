---
/*
 * The share image's source (1200 × 630). Rendered to public/og.png with
 * `pnpm og` while `pnpm dev` runs. Not linked from the site.
 */
import "@fontsource-variable/ibm-plex-sans/wght.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-serif/500-italic.css";
import Mark from "../components/Mark.astro";
import "../styles/tokens.css";

const lines = [
  { verb: "Find", rest: " what applies.", dye: "var(--dye-0)" },
  { verb: "Improve", rest: " what works.", dye: "var(--dye-1)" },
  { verb: "Share", rest: " what you learn.", dye: "var(--dye-2)" },
];
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Habi — share image</title>
    <style>
      body { margin: 0; width: 1200px; height: 630px; overflow: hidden; background: var(--paper); color: var(--ink);
        font-family: "IBM Plex Sans Variable", sans-serif; }
      .og { position: relative; height: 100%; padding: 60px 80px 0; box-sizing: border-box; }
      .top { display: flex; align-items: center; justify-content: space-between; }
      .brand { display: flex; align-items: center; gap: 18px; font-size: 44px; font-weight: 650; letter-spacing: -0.035em; }
      .tag { font-family: "IBM Plex Mono", monospace; font-size: 22px; color: var(--thread-strong); }
      .cloth { position: relative; margin-top: 44px; padding-left: 52px; }
      .w { position: absolute; left: 0; width: 9px; border-radius: 5px; background: var(--dye); }
      h1 { margin: 0; font-size: 90px; font-weight: 650; letter-spacing: -0.05em; line-height: 1.06; }
      h1 span { display: block; white-space: nowrap; }
      h1 em { font-family: "IBM Plex Serif", serif; font-style: italic; font-weight: 500; letter-spacing: -0.03em; color: var(--dye); }
      .weft { position: absolute; left: -80px; right: -80px; top: var(--weft); height: 8px; border-radius: 4px; background: var(--thread); box-shadow: 0 0 0 5px var(--paper); }
      .purpose { position: absolute; left: 80px; right: 80px; bottom: 54px; }
      .purpose p { margin: 0; font-size: 30px; white-space: nowrap; line-height: 1.3; color: var(--ink-soft); letter-spacing: -0.01em; }
      .purpose b { color: var(--ink); font-weight: 600; }
    </style>
  </head>
  <body>
    <div class="og">
      <div class="top">
        <div class="brand"><Mark size={56} /> Habi</div>
        <div class="tag">acltabontabon.com/habi</div>
      </div>
      <div class="cloth" style="--weft:318px">
        {lines.map((l, i) => <i class="w" style={`--dye:${l.dye};top:${i * 95 + 8}px;height:${i === 2 ? 95 + 26 : 95}px`} />)}
        <h1>
          {lines.map((l) => <span style={`--dye:${l.dye}`}><em>{l.verb}</em>{l.rest}</span>)}
        </h1>
        <i class="weft"></i>
      </div>
      <div class="purpose">
        <p>The desktop app for the <b>skills &amp; instructions</b> you give AI coding agents.</p>
      </div>
    </div>
  </body>
</html>
