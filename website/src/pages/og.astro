---
/*
 * The share image's source (1200 × 630). Rendered to public/og-v2.png with
 * `pnpm og` while `pnpm dev` runs. Not linked from the site.
 */
import "@fontsource-variable/ibm-plex-sans/wght.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-serif/500-italic.css";
import Mark from "../components/Mark.astro";
import "../styles/tokens.css";

const shot = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/media/dark/project.jpg`;
const lines = [
  { verb: "Find", rest: " what applies." },
  { verb: "Improve", rest: " what works." },
  { verb: "Share", rest: " what you learn." },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Habi — share image</title>
    <style>
      body { margin: 0; width: 1200px; height: 630px; overflow: hidden; background: var(--paper); color: var(--ink);
        font-family: "IBM Plex Sans Variable", sans-serif; }
      .og { position: relative; width: 100%; height: 100%; overflow: hidden;
        background:
          radial-gradient(640px 520px at 800px 330px, rgba(242, 165, 65, 0.16), transparent 70%),
          var(--paper); }
      .brand { position: absolute; left: 72px; top: 56px; display: flex; align-items: center; gap: 16px; font-size: 38px; font-weight: 650; letter-spacing: -0.035em; }
      .copy { position: absolute; left: 72px; top: 168px; }
      h1 { margin: 0; font-size: 56px; font-weight: 650; letter-spacing: -0.045em; line-height: 1.12; }
      h1 span { display: block; white-space: nowrap; }
      h1 em { font-family: "IBM Plex Serif", serif; font-style: italic; font-weight: 500; letter-spacing: -0.025em; color: var(--thread-strong); }
      .purpose { position: absolute; left: 72px; top: 420px; margin: 0; white-space: nowrap; font-size: 24px; line-height: 1.4; color: var(--ink-muted); letter-spacing: -0.005em; }
      .purpose b { color: var(--ink); font-weight: 600; }
      .url { position: absolute; left: 72px; bottom: 40px; font-family: "IBM Plex Mono", monospace; font-size: 20px; color: var(--thread-strong); }
      .weft { position: absolute; left: 0; right: 0; top: 536px; height: 6px; border-radius: 3px; background: var(--thread); opacity: 0.9; }
      .stage { position: absolute; left: 640px; top: 70px; width: 760px; height: 640px; perspective: 1800px; }
      .win { position: absolute; inset: 0; border-radius: 16px; overflow: hidden; background-color: var(--paper-raised);
        background-size: 1440px auto; background-position: -640px -216px; background-repeat: no-repeat;
        transform: rotateY(-16deg) rotateX(5deg) rotateZ(-1.5deg); transform-origin: 0% 50%;
        box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1), 0 40px 90px rgba(0, 0, 0, 0.7), 0 0 120px rgba(242, 165, 65, 0.14); }
    </style>
  </head>
  <body>
    <div class="og">
      <div class="weft"></div>
      <div class="brand"><Mark size={50} /> Habi</div>
      <div class="copy">
        <h1>
          {lines.map((l) => <span><em>{l.verb}</em>{l.rest}</span>)}
        </h1>
      </div>
      <p class="purpose">The desktop app for the <b>skills &amp; instructions</b><br />you give AI coding agents.</p>
      <div class="url">acltabontabon.com/habi</div>
      <div class="stage"><div class="win" style={`background-image:url(${shot})`}></div></div>
    </div>
  </body>
</html>
