---
/*
 * The problem, the way every developer has lived it: the two ways you try
 * to find a skill today — ask around, or search — played side by side, once,
 * as the section comes into view. Archetypes, not an incident: no names,
 * no numbers.
 *
 * Every line carries its start time (--t, ms). Without scripts, or with
 * reduced motion, the whole exchange is simply shown.
 */
type Msg = { who: string; dye: number; text: string; t: number; you?: boolean };
const thread: Msg[] = [
  { who: "you", dye: 2, text: "does anyone have a skill for reviewing liquibase migrations? 🙏", t: 0, you: true },
  { who: "payments-dev", dye: 3, text: "platform had one I think", t: 1300 },
  { who: "platform-oncall", dye: 0, text: "we had one??", t: 2200 },
  { who: "platform-oncall", dye: 0, text: "oh wait, it's in agent-skills. or the old repo", t: 3000 },
  { who: "data-eng", dye: 4, text: "I have one locally, it's better, will DM", t: 4100 },
  { who: "payments-dev", dye: 3, text: "is that the one that forgets rollbacks", t: 5200 },
  { who: "you", dye: 2, text: "the link 404s", t: 6300, you: true },
  { who: "you", dye: 2, text: "found one. fixed the rollback step. where do I send the fix?", t: 7600, you: true },
  { who: "platform-oncall", dye: 0, text: "just keep it locally 🤷", t: 8700 },
];

type Line = { cmd?: string; out?: string[]; err?: boolean; t: number };

const session: Line[] = [
  { cmd: "grep -rli liquibase ~/work/*/.claude/skills ~/.claude/skills", t: 600 },
  {
    out: [
      "~/work/billing-service/.claude/skills/liquibase-review/SKILL.md",
      "~/work/orders-api/.claude/skills/migration-review-v2/SKILL.md",
      "~/work/orders-api/.claude/skills/migration-review-v2-FINAL/SKILL.md",
      "~/work/inventory/.claude/skills/db-migrations (copy)/SKILL.md",
      "~/.claude/skills/db-migrations/SKILL.md",
    ],
    t: 2300,
  },
  { cmd: "diff migration-review-v2 migration-review-v2-FINAL", t: 3300 },
  { out: ["< 4. Check for rollbacks.", "> 4. Check for rollbacks. (for real this time)"], t: 4700 },
  { cmd: "head -1 ~/.claude/skills/db-migrations/SKILL.md", t: 5500 },
  { out: ["# TODO: write this properly"], t: 6700 },
  { cmd: "which-one-is-right", t: 7400 },
  { out: ["zsh: command not found: which-one-is-right"], err: true, t: 8300 },
];
---

<section class="problem" id="problem" aria-labelledby="problem-title">
  <div class="screen problem-ask">
  <p class="kicker">The problem</p>
  <h2 id="problem-title" class="problem-title">
    Someone in your company already wrote this skill. <em>Good luck finding it.</em>
  </h2>

  <div class="play" data-reveal>
  <div class="ordeal">
    <figure class="chat" aria-label="Asking around">
      <figcaption class="ordeal-label mono">Ask around</figcaption>
      <p class="chat-head mono"># engineering</p>
      <ol class="chat-thread">
        {
          thread.map((m) => (
            <li class:list={["msg", { "is-you": m.you }]} style={`--t:${m.t};--dye:var(--dye-${m.dye})`}>
              <span class="msg-avatar" aria-hidden="true">
                {m.who.slice(0, 1).toUpperCase()}
              </span>
              <span class="msg-who mono">{m.who}</span>
              <span class="msg-text">{m.text}</span>
            </li>
          ))
        }
        <li class="msg-react" style="--t:9300">
          <span>👀 4</span>
        </li>
        <li class="msg-system mono" style="--t:10000">Last reply 3 months ago.</li>
      </ol>
    </figure>

    <figure class="shell" aria-label="Searching">
      <figcaption class="ordeal-label mono">Search</figcaption>
      <div class="shell-body mono">
        {
          session.map((l) =>
            l.cmd ? (
              <p class="shell-cmd" style={`--t:${l.t};--n:${l.cmd.length}`}>
                <span class="shell-prompt" aria-hidden="true">
                  ~ ${" "}
                </span>
                <span class="shell-typed">{l.cmd}</span>
              </p>
            ) : (
              <div class:list={["shell-out", { "is-err": l.err }]} style={`--t:${l.t}`}>
                {l.out?.map((o) => (
                  <p>{o}</p>
                ))}
              </div>
            ),
          )
        }
      </div>
    </figure>
  </div>

  </div>
  <div class="turn" data-reveal>
    <p class="problem-turn">Stop asking around. <em>Ask your repository.</em></p>
    <ol class="answers">
      <li>
        <p class="answer-label mono"><span>01</span> Explore</p>
        <p>
          Every library your teams already keep — and the community's — in one place. No more #engineering
          archaeology.
        </p>
      </li>
      <li>
        <p class="answer-label mono"><span>02</span> Check</p>
        <p>
          Habi reads the repository you're in and tells you which skills apply, and why — down to
          <code>pom.xml:31</code>.
        </p>
      </li>
      <li>
        <p class="answer-label mono"><span>03</span> Pay it forward</p>
        <p>
          Fixed a step? Send it back to the team that owns it as one reviewed pull request. Everyone gets it on
          refresh.
        </p>
      </li>
    </ol>
  </div>
  </div>
</section>
