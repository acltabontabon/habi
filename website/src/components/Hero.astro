---
/*
 * A billboard, the way a streaming service opens: a still first, then, after
 * a beat, the film eases in behind the words, muted and quiet, and when it
 * ends the still comes back. It is only ever a backdrop; everything it is
 * behind reads without it. A press on the sound button starts the chapter
 * over with the music, and the small button beside it takes the film full
 * screen. With reduced motion or data saver it never starts by itself
 * (scripts/hero.ts).
 *
 * Nothing is written over it, and nothing under it: the film tells the problem
 * itself. What the word means, and the button, are in the header.
 */
import demo from "../data/demo.json";
import Icon from "./Icon.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const repo = "https://github.com/acltabontabon/habi";
---

<section class="bill" id="demo" data-hero aria-labelledby="hero-title">
  <div class="bill-media" aria-hidden="true">
    <img class="bill-still" src={`${base}media/demo-poster.jpg`} alt="" width="1440" height="900" fetchpriority="high" />
    <video class="bill-video" data-hero-video muted playsinline preload="none" tabindex="-1">
      <source src={`${base}media/demo.mp4`} type="video/mp4" />
    </video>
  </div>

  <svg class="bill-loom" viewBox="220 190 584 644" aria-hidden="true" focusable="false">
    <path class="lm-warp" d="M660 236V788"></path>
    <path class="lm-weft" d="M268 520H756" pathLength="1"></path>
    <path class="lm-warp" d="M364 236V788"></path>
  </svg>

  <h1 id="hero-title" class="visually-hidden">Habi weaves your team's AI agent skills together</h1>

  <div class="bill-inner">
    <div class="bill-ctl" data-hero-ctl>
      <button class="bill-btn" type="button" data-hero-sound aria-label="Play the film with sound">
        <Icon name="mute" size={16} />
      </button>
      <button class="bill-btn" type="button" data-hero-full aria-label="Watch the film full screen">
        <Icon name="layers" size={16} />
      </button>
    </div>
  </div>
</section>
