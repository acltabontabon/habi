---
import demo from "../data/demo.json";
import Icon from "./Icon.astro";

/*
 * The film: the real app, staged like an ad
 * (scripts/render-film.mjs makes it; scripts/film/ is its source), shown in a
 * cinema: a dialog over the page, opened from the filmstrip in the hero or
 * "Watch the film", at the chosen chapter and with sound (scripts/film.ts).
 * /#demo opens it too. The progress bar is a thread: the weft, passing across
 * as the film runs; the filmstrip is its chapter list.
 */
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<dialog class="cinema" id="demo" aria-labelledby="demo-title" data-demo>
  <div class="cinema-head">
    <h2 id="demo-title" class="cinema-title">Habi, <em>the film</em></h2>
    <button class="cinema-close" type="button" data-film-close aria-label="Close the film">
      <Icon name="close" size={18} />
    </button>
  </div>

  <figure class="film" data-film-frame>
    <div class="win">
      <p class="win-bar mono" aria-hidden="true">
        <span class="win-lights"><i></i><i></i><i></i></span>
        <span class="win-title">Habi</span>
        <span class="win-time" data-film-time>0:00</span>
      </p>
      <div class="film-screen">
        <video
          class="film-video"
          data-film
          muted
          playsinline
          loop
          preload="none"
          poster={`${base}media/demo-poster.jpg`}
          aria-label="A film of Habi finding, installing, writing and sharing agent skills, with music"
        >
          <source src={`${base}media/demo.mp4`} type="video/mp4" />
        </video>
        <button class="film-play" type="button" data-film-toggle aria-label="Play the film">
          <span class="film-play-disc"><Icon name="play" size={22} /></span>
        </button>
        <button class="film-sound" type="button" data-film-sound aria-pressed="false">
          <Icon name="mute" size={15} />
          <span>Sound off</span>
        </button>
      </div>
      <div class="film-thread" data-film-seek role="slider" aria-label="Position in the film" aria-valuemin="0" aria-valuemax={Math.round(demo.seconds)} aria-valuenow="0" tabindex="0">
        <span class="film-thread-fill" data-film-fill></span>
        <span class="film-thread-knot" data-film-knot></span>
      </div>
    </div>
  </figure>
</dialog>
