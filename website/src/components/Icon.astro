---
/** The few line icons the site uses, from the app (apps/desktop/src/components/Icon.tsx): 16px grid, 1.5 stroke. */
const paths = {
  external: "M9.5 3h3.5v3.5M13 3L8 8M11.5 9.5V13H3V4.5h3.5",
  download: "M8 2.5V10M5 7l3 3 3-3M3.5 12.5h9",
  layers: "M8 2.5l5.5 3L8 8.5l-5.5-3zM2.5 8L8 11l5.5-3M2.5 10.5L8 13.5l5.5-3",
  mute: "M2.5 6.5h2.5L8.5 3.5v9L5 9.5H2.5zM10.8 6l3.4 4M14.2 6l-3.4 4",
} as const;

interface Props {
  name: keyof typeof paths;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 16, label, class: className } = Astro.props;
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
  focusable="false"><path d={paths[name]}></path></svg>
