---
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";

interface Props {
  /** The section the page belongs to, marked in the navigation. */
  current?: "docs";
}

const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const repo = "https://github.com/acltabontabon/habi";
---

<header class="top" data-top>
  <div class="top-inner">
    <div class="top-left">
      <a class="brand" href={base} aria-label="Habi, home">
        <Mark size={24} />
        <span>Habi</span>
      </a>
      <p class="top-def mono"><b>ha·bi</b> <span>/ˈha.bi/</span> Filipino, <em>to weave</em></p>
    </div>
    <nav class="top-nav" aria-label="Site">
      <a href={`${base}#tour`} class="top-link hide-sm">How it works</a>
      <a href={`${base}#promises`} class="top-link hide-sm">Principles</a>
      <a href={`${base}docs/`} class="top-link" aria-current={current === "docs" ? "page" : undefined}>Docs</a>
      <a class="top-get" href={`${repo}/releases/latest`} data-download>Download</a>
    </nav>
  </div>
</header>

<!--
  Download: a small chooser, not a button that shouts. The header's link still goes
  to the release page without scripts; with them it opens this, with the system the
  visitor is on marked, and the real installers (scripts/download.ts).
-->
<dialog class="get" data-get aria-labelledby="get-title">
  <button class="get-close" type="button" data-get-close aria-label="Close">
    <Icon name="close" size={16} />
  </button>

  <p class="get-kicker mono">Download <span data-get-version></span></p>
  <h2 id="get-title" class="get-title">Where will you <em>weave?</em></h2>

  <div class="get-grid">
    <a class="get-tile" href={`${repo}/releases/latest`} data-get-os="macOS" style="--i:0">
      <span class="get-flag mono">your system</span>
      <span class="get-os">macOS</span>
      <span class="get-meta mono">Apple silicon &amp; Intel</span>
      <span class="get-file mono" data-get-file>.dmg</span>
    </a>
    <a class="get-tile" href={`${repo}/releases/latest`} data-get-os="Windows" style="--i:1">
      <span class="get-flag mono">your system</span>
      <span class="get-os">Windows</span>
      <span class="get-meta mono">10 &amp; 11, 64-bit</span>
      <span class="get-file mono" data-get-file>.exe</span>
    </a>
  </div>

  <p class="get-note">
    Free and open source. Not signed, so the first launch asks once:{" "}
    <a href={`${base}docs/getting-started/#installing`}>here is how</a>.
  </p>
</dialog>

<script>
  import "../scripts/download";
</script>
