---
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";

interface Props {
  /** The section the page belongs to, marked in the navigation. */
  current?: "docs";
}

const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const repo = "https://github.com/acltabontabon/habi";
---

<header class="top" data-top>
  <div class="top-inner">
    <a class="brand" href={base} aria-label="Habi, home">
      <Mark size={24} />
      <span>Habi</span>
    </a>
    <nav class="top-nav" aria-label="Site">
      <a href={`${base}docs/`} class="top-link" aria-current={current === "docs" ? "page" : undefined}>Docs</a>
      <a href={repo} class="top-link">GitHub <Icon name="external" size={12} /></a>
    </nav>
  </div>
</header>
