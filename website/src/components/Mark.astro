---
/** The Habi mark: two warps and one weft interlaced into an H (design/habi-mark.svg). */
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className } = Astro.props;
---

<svg class:list={["mark", className]} width={size} height={size} viewBox="0 0 1024 1024" aria-hidden="true" focusable="false">
  <rect width="1024" height="1024" rx="232" fill="var(--ink)"></rect>
  <g fill="none">
    <line class="mark-weft" x1="268" y1="520" x2="756" y2="520" stroke="var(--thread)" stroke-width="76" stroke-linecap="round"></line>
    <line x1="660" y1="236" x2="660" y2="788" stroke="var(--paper)" stroke-width="76" stroke-linecap="round"></line>
    <line x1="614" y1="520" x2="706" y2="520" stroke="var(--ink)" stroke-width="124"></line>
    <line x1="606" y1="520" x2="714" y2="520" stroke="var(--thread)" stroke-width="76"></line>
    <line x1="364" y1="466" x2="364" y2="574" stroke="var(--ink)" stroke-width="124"></line>
    <line x1="364" y1="236" x2="364" y2="788" stroke="var(--paper)" stroke-width="76" stroke-linecap="round"></line>
  </g>
</svg>
