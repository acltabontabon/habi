---
import Icon from "./Icon.astro";

const repo = "https://github.com/acltabontabon/habi";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<div class="screen finale">
<section class="start" id="start" aria-labelledby="start-title" data-reveal>
  <h2 id="start-title" class="start-title">
    <span>Mute #engineering.</span>
    <em>Start weaving.</em>
  </h2>
  <div class="start-actions">
    <a class="btn btn-primary btn-big" href={`${repo}/releases/latest`} data-download>
      <Icon name="download" size={16} />
      <span data-download-label>Download</span>
    </a>
    <a class="btn btn-quiet btn-big" href={`${repo}/blob/main/CONTRIBUTING.md#set-up`}>
      <Icon name="terminal" size={14} />
      Build from source
    </a>
  </div>
  <p class="start-note">
    For macOS and Windows, from GitHub Releases. The first launch offers a sample workspace to try everything on, and
    removes it in one step. Not signed by Apple or Microsoft, so that first launch asks once;
    <a href={`${base}docs/getting-started/#installing`}>here is how</a>.
  </p>
</section>

<footer class="foot">
  <p class="woven-word" aria-label="habi">
    <span class="woven-word-text" aria-hidden="true">habi</span>
    <span class="woven-word-warps" aria-hidden="true">
      {
        [12, 30, 50, 70, 88].map((x, i) => (
          <i class:list={{ "is-over": i % 2 === 0 }} style={`--x:${x}%;--dye:var(--dye-${[0, 1, 4, 2, 3][i]})`} />
        ))
      }
      <b></b>
    </span>
  </p>
  <div class="lexeme">
    <p class="lexeme-head"><b>ha·bi</b> <span class="mono">/ˈha.bi/</span> <i>Filipino</i></p>
    <p class="lexeme-body">
      To weave: to pass one thread over and under the others until, together, they <em>hold</em>.
    </p>
  </div>
</footer>
</div>
