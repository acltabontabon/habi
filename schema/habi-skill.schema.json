{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/acltabontabon/habi/main/schema/habi-skill.schema.json",
  "title": "Habi skill metadata (habi.yaml)",
  "description": "Optional sidecar placed next to a SKILL.md. It adds applicability, prerequisites, workflow guidance and evidence that the Agent Skills format does not express. Version 1.",
  "type": "object",
  "required": ["habi"],
  "additionalProperties": true,
  "properties": {
    "habi": {
      "description": "Schema version of this file.",
      "const": 1
    },
    "id": {
      "description": "Stable identifier within the library. Defaults to the SKILL.md name.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "kind": {
      "description": "A workflow is a skill that also describes an ordered procedure.",
      "enum": ["skill", "workflow"]
    },
    "owner": {
      "description": "Who maintains this content (attribution only, not access control).",
      "type": "string",
      "maxLength": 120
    },
    "requirement": {
      "description": "`required` marks a team requirement: it is always listed, never filtered away.",
      "enum": ["recommended", "required"]
    },
    "priority": {
      "description": "Explicit team ordering among relevant items. Higher comes first.",
      "type": "integer",
      "minimum": -100,
      "maximum": 100
    },
    "scope": {
      "description": "`module` evaluates conditions per module (default); `repository` evaluates them across the whole repository.",
      "enum": ["module", "repository"]
    },
    "applies_when": { "$ref": "#/$defs/condition" },
    "excludes": { "$ref": "#/$defs/condition" },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["name", "commands"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 80 },
              "commands": {
                "description": "Any one of these satisfies the requirement. Bare names are looked up on PATH; `./name` is looked up in the module and repository root. Nothing is executed.",
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": { "type": "string", "pattern": "^(\\./)?[A-Za-z0-9._+-]{1,64}$" }
              },
              "purpose": { "type": "string", "maxLength": 300 },
              "install_hint": { "type": "string", "maxLength": 300 }
            }
          }
        },
        "mcp": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/mcpRequirement" }
        },
        "clients": {
          "description": "Clients this content is known to work with. Omit when not restricted.",
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["claude-code", "cursor", "codex"] }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "required": ["title"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 160 },
              "detail": { "type": "string", "maxLength": 4000 },
              "references": {
                "type": "array",
                "maxItems": 10,
                "items": { "$ref": "#/$defs/relativePath" }
              },
              "expected": { "type": "string", "maxLength": 1000 }
            }
          }
        },
        "artifacts": {
          "description": "What following the workflow is expected to produce.",
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "bindings": {
      "description": "Repository-specific values a check needs. Habi lists discovered candidates; the user chooses.",
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
          "kind": { "enum": ["file", "module"] },
          "glob": { "type": "string", "maxLength": 256 },
          "description": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "title", "run"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "description": { "type": "string", "maxLength": 1000 },
          "run": {
            "description": "Program and arguments, as an array. Never passed through a shell.",
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {
              "oneOf": [
                { "type": "string", "maxLength": 500 },
                {
                  "type": "object",
                  "required": ["binding"],
                  "additionalProperties": false,
                  "properties": { "binding": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" } }
                }
              ]
            }
          },
          "cwd": { "enum": ["module", "repository"] },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
        }
      }
    },
    "evidence": {
      "description": "Author-declared verification records. Habi shows them as declared, not as checked.",
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["date", "result"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "result": { "enum": ["passed", "failed", "partial"] },
          "environment": { "type": "string", "maxLength": 300 },
          "summary": { "type": "string", "maxLength": 1000 },
          "by": { "type": "string", "maxLength": 120 }
        }
      }
    },
    "examples": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["title"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "maxLength": 160 },
          "description": { "type": "string", "maxLength": 2000 },
          "path": { "$ref": "#/$defs/relativePath" }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^/\\\\:][^\\\\:]*$",
      "$comment": "Habi additionally rejects `..` segments when loading."
    },
    "envReference": {
      "description": "A reference to an environment variable. Literal secrets are not allowed in shared metadata.",
      "type": "string",
      "pattern": "^\\$\\{[A-Za-z_][A-Za-z0-9_]{0,63}\\}$"
    },
    "mcpRequirement": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Server name as it appears in client configuration.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "purpose": { "type": "string", "maxLength": 300 },
        "server": {
          "description": "Suggested configuration Habi can propose (after review) for clients that lack it.",
          "oneOf": [
            {
              "type": "object",
              "required": ["command"],
              "additionalProperties": false,
              "properties": {
                "command": { "type": "string", "minLength": 1, "maxLength": 200 },
                "args": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 300 } },
                "env": {
                  "type": "object",
                  "maxProperties": 20,
                  "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
                  "additionalProperties": { "$ref": "#/$defs/envReference" }
                }
              }
            },
            {
              "type": "object",
              "required": ["url"],
              "additionalProperties": false,
              "properties": {
                "url": { "type": "string", "pattern": "^https://[^\\s@]+$", "maxLength": 500 },
                "bearer_token_env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" }
              }
            }
          ]
        }
      }
    },
    "condition": {
      "description": "Applicability condition. Exactly one key per object.",
      "oneOf": [
        {
          "type": "object",
          "required": ["all"],
          "additionalProperties": false,
          "properties": { "all": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object",
          "required": ["any"],
          "additionalProperties": false,
          "properties": { "any": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object",
          "required": ["not"],
          "additionalProperties": false,
          "properties": { "not": { "$ref": "#/$defs/condition" } }
        },
        {
          "type": "object",
          "required": ["dependency"],
          "additionalProperties": false,
          "properties": {
            "dependency": {
              "oneOf": [
                { "type": "string", "minLength": 1, "maxLength": 200 },
                {
                  "type": "object",
                  "required": ["name"],
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
                    "ecosystem": { "enum": ["maven", "gradle", "npm", "go", "cargo", "pypi", "composer", "jvm"] },
                    "version": { "type": "string", "minLength": 1, "maxLength": 100 }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": ["file"],
          "additionalProperties": false,
          "properties": { "file": { "type": "string", "minLength": 1, "maxLength": 256 } }
        },
        {
          "type": "object",
          "required": ["tag"],
          "additionalProperties": false,
          "properties": { "tag": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:._-]{0,79}$" } }
        }
      ]
    }
  }
}
